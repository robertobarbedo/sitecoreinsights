---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Set for posts so social cards and search engines treat the page as an article. */
  article?: { pubDate: Date; updatedDate?: Date; tags: string[] };
  noindex?: boolean;
  sidebar?: boolean;
}

const { title, description = SITE.description, article, noindex = false, sidebar = true } = Astro.props;

const pageTitle = title ? `${title} - ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      author: { '@type': 'Person', name: SITE.author },
      mainEntityOfPage: canonical.href,
      keywords: article.tags.join(', '),
    }
  : null;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <div class:list={['container', 'site-content', { 'site-content--full': !sidebar }]}>
      <main id="main" class="content-area">
        <slot />
      </main>
      {sidebar && <Sidebar />}
    </div>
    <Footer />
  </body>
</html>
