---
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container site-branding">
    <p class="site-title"><a href="/">{SITE.name}</a></p>
    <p class="site-description">{SITE.tagline}</p>
  </div>
  <nav class="main-nav" aria-label="Main">
    <div class="container">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--border);
  }

  .site-branding {
    padding-top: 28px;
    padding-bottom: 22px;
  }

  .site-title {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .site-title a {
    color: var(--text);
  }

  .site-title a:hover {
    text-decoration: none;
  }

  .site-description {
    margin: 4px 0 0;
    color: var(--text-light);
    font-size: 15px;
  }

  .main-nav {
    border-top: 1px solid var(--border);
  }

  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -14px;
    padding: 0;
    list-style: none;
  }

  .main-nav a {
    display: block;
    padding: 12px 14px;
    color: var(--text);
    font-size: 15px;
  }

  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    color: var(--link);
    text-decoration: none;
  }
</style>
